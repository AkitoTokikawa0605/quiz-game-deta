[_tb_system_call storage=system/_option.ks]
*start

; スライダープラグインを読み込む
[plugin name="uiparts_set"]

[cm]
[clearfix]
[freeimage layer="1"]
[freeimage layer="2"]
[hidemenubutton]

; レイヤー1とレイヤー2を表示状態にする
[layopt layer="1" visible="true"]
[layopt layer="2" visible="true"]

; 変数の初期値設定
[iscript]
if(sf.bgm_vol == undefined){ sf.bgm_vol = 50; }
if(sf.se_vol == undefined){ sf.se_vol = 50; }
if(sf.voice_vol == undefined){ sf.voice_vol = 50; }

if(sf.screen_mode == undefined){ sf.screen_mode = 0; }
[endscript]

; 背景を表示
[bg storage="haikei/option_haikei.png" time="500"]

; タイトル
[image layer="2" page="fore" storage="UI/option.png" x="500" y="85" width="310" height="100" reflect="false"]

; BGM音量
[image layer="2" page="fore" storage="UI/bgm.png" x="190" y="230" width="180" height="45" reflect="false"]

[slider name="bgm_slider" x="400" y="250" width="600" height="18" min="0" max="100" var="sf.bgm_vol" target="*change_bgm" base_color="#DDF2FC" active_color="#95D2F4" border="2" border_color="black" border_radius="30"]


; SE音量
[image layer="2" page="fore" storage="UI/se.png" x="190" y="330" width="180" height="45" reflect="false"]

[slider name="se_slider" x="400" y="350" width="600" height="18" min="0" max="100" var="sf.se_vol" target="*change_se" base_color="#E2F5E1" active_color="#A8E4A6" border="2" border_color="black" border_radius="30"]


; ボイス音量
[image layer="2" page="fore" storage="UI/vaoice.png" x="190" y="430" width="180" height="45" reflect="false"]

[slider name="voice_slider" x="400" y="450" width="600" height="18" min="0" max="100" var="sf.voice_vol" target="*change_voice" base_color="#FCE7EE" active_color="#F7C2D4" border="2" border_color="black" border_radius="30"]

; --- 画面モード：切り替え ---

[image layer="2" page="fore" storage="UI/confg.png" x="160" y="582" width="220" height="55" reflect="false"]

[if exp="sf.screen_mode == 0"]

; ==========================
; 【現在：ウィンドウ状態】
; ==========================

; WD（左側・選択中：通常の音符画像）
[image layer="2" storage="UI/onp.png" x="390" y="596" width="45" height="45"]
[image layer="2" storage="UI/win.png" x="430" y="590" width="180" height="58"]

; FSR（右側・未選択：グレー音符の画像を表示 ＋ その上に透明なクリック判定を重ねる）
[image layer="2" storage="UI/onp01.png" x="630" y="596" width="45" height="45"]
[clickable x="630" y="596" width="45" height="45" target="*change_fullscreen"]
[image layer="2" storage="UI/Fwin.png" x="680" y="590" width="220" height="58"]

[else]

; ==========================
; 【現在：フルスクリーン状態】
; ==========================

; WD（左側・未選択：グレー音符の画像を表示 ＋ その上に透明なクリック判定を重ねる）
[image layer="2" storage="UI/onp01.png" x="390" y="596" width="45" height="45"]
[clickable x="390" y="596" width="45" height="45" target="*change_window"]
[image layer="2" storage="UI/win.png" x="430" y="590" width="180" height="58"]

; FSR（右側・選択中：通常の音符画像）
[image layer="2" storage="UI/onp.png" x="630" y="596" width="45" height="45"]
[image layer="2" storage="UI/Fwin.png" x="680" y="590" width="220" height="58"]

[endif]

; 戻るボタン（通常時とホバー時を指定）
[button graphic="button/button17.png" enterimg="button/button17_1.png" x="1000" y="585" target="*back_to_title"]
[s]

; --- 処理部 ---

*change_bgm
[bgmopt volume="&sf.bgm_vol"]
[return]

*change_se
[seopt volume="&sf.se_vol"]
[return]

*change_voice
[seopt buf="2" volume="&sf.voice_vol"]
[return]

*change_window
[clearfix]          ; ←これであらゆる古いクリック判定を完全消去！
[freeimage layer="2"]
[screen_full full="false"]
[eval exp="sf.screen_mode=0"]
[jump target="*start"]

*change_fullscreen
[clearfix]          ; ←これであらゆる古いクリック判定を完全消去！
[freeimage layer="2"]
[screen_full]
[eval exp="sf.screen_mode=1"]
[jump target="*start"]

*back_to_title
[cm]
[clearfix]
[freeimage layer="1"]
[freeimage layer="2"]
[jump storage="title_screen.ks" target="*show_menu"]
